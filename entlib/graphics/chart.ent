module graphics.chart

fn draw_rect(x: f64, y: f64, w: f64, h: f64, depth: f64, r: f64, g: f64, b: f64) -> f64 {
  draw_triangle(x, y, depth, r, g, b, x + w, y, depth, r, g, b, x + w, y + h, depth, r, g, b)
  draw_triangle(x, y, depth, r, g, b, x + w, y + h, depth, r, g, b, x, y + h, depth, r, g, b)
  return 1.0
}

fn draw_bar(x: f64, baseline: f64, width_value: f64, value: f64, scale: f64, r: f64, g: f64, b: f64) -> f64 {
  let h: f64 = value * scale
  draw_rect(x, baseline - h, width_value, h, 0.42, r, g, b)
  return h
}

fn draw_gridline(y: f64, x0: f64, x1: f64) -> f64 {
  draw_rect(x0, y, x1 - x0, 2.0, 0.80, 0.12, 0.14, 0.16)
  return 1.0
}
