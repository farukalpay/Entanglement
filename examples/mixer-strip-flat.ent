    let fact = rule parser_admissible_from_parser(row)
    qed fact
  }
  proof yaml_parser {
    let row = row parser yaml_cfg
    let fact = rule parser_admissible_from_parser(row)
    qed fact
  }
  proof yml_parser {
    let row = row parser yml_cfg
    let fact = rule parser_admissible_from_parser(row)
    qed fact
  }
  proof flat_selection {
    let row = row selection flat_code
    let fact = rule selection_admissible_from_selection(row)
    qed fact
